# Copie este arquivo para .env e preencha.

# console.cloud.google.com > criar projeto > ativar "YouTube Data API v3" > Credenciais > Chave de API
YOUTUBE_API_KEY=

# aistudio.google.com > Get API key (a cota gratuita cobre roteiro e narração)
GEMINI_API_KEY=
# GEMINI_MODELO=gemini-3.8-flash
# GEMINI_TTS_MODELO=gemini-3.8-flash-tts   # ou gemini-3.8-flash-lite-tts, que tem cota própria

# freesound.org > criar conta > freesound.org/apiv2/apply (sons reais de animais, só licença CC0)
FREESOUND_API_KEY=

# Reserva local quando a cota do Gemini acaba (Ollama já instalado)
# MODELO_LOCAL=gemma4:26b
